<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rehabilitation_robot</name>
  <version>1.0.0</version>
  <description>Embodied AI Rehabilitation Robot System for upper and lower limb training</description>
  <maintainer email="developer@rehabrobot.org">Development Team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ur_robot_driver</exec_depend>
  <exec_depend>moveit2</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <depend>numpy</depend>
  <depend>scipy</depend>
  <depend>torch</depend>
  <depend>scikit-learn</depend>
  <depend>pyyaml</depend>

  <test_depend>pytest</test_depend>
  <test_depend>pytest-cov</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
